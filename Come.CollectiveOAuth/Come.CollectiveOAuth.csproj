<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net462;netstandard2.0;net8.0</TargetFrameworks>
    <SignAssembly>false</SignAssembly>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!-- NuGet 包信息 -->
  <PropertyGroup>
    <PackageId>Rthinking.CollectiveOAuth</PackageId>
    <Version>2.0.0</Version>
    <Authors>Rthinking</Authors>
    <Company>Rthinking Technology Co., Ltd.</Company>
    <Product>CollectiveOAuth</Product>
    <Description>.NET 平台第三方 OAuth 登录聚合库，对齐 JustAuth 1.16.7。一套接口接入微信、企业微信、支付宝、钉钉、QQ、微博、抖音、华为、淘宝、GitHub、Google、Microsoft、Twitter 等 31 个平台。</Description>
    <PackageTags>oauth;oauth2;login;third-party-login;wechat;alipay;dingtalk;qq;github;google;justauth</PackageTags>
    <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
    <PackageProjectUrl>https://geekoutnet.github.io/CollectiveOAuth/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/geekoutnet/CollectiveOAuth</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>2.0.0：全部 31 个平台对齐 JustAuth 1.16.7；支持 .NET Framework 4.6.2+、.NET Standard 2.0、.NET 8。升级注意事项见 https://github.com/geekoutnet/CollectiveOAuth#从旧版本升级</PackageReleaseNotes>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\docs\images\icon.png" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\docs\nuget\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.2" />
    <InternalsVisibleTo Include="Come.CollectiveOAuth.Tests" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net462'">
    <PackageReference Include="AlipaySDKNet" Version="4.2.13" />
    <Reference Include="System.Core" />
    <Reference Include="System.Data" />
    <Reference Include="System.Data.DataSetExtensions" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Web" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.Configuration" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'net462'">
    <PackageReference Include="AlipaySDKNet.Standard" Version="4.2.13" />
    <PackageReference Include="Microsoft.Extensions.Caching.Abstractions" Version="3.1.1" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="3.1.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="3.1.1" />
    <PackageReference Include="System.Xml.XmlDocument" Version="4.3.0" />
    <PackageReference Include="System.Xml.XPath.XmlDocument" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Net.Http" Version="4.3.4" />
  </ItemGroup>
</Project>
